# Copy to .env.test.local; never commit populated secrets.
NODE_ENV=test
GUARDIAN_ENVIRONMENT=test

# Must point to a disposable test database, never production.
DATABASE_URL=

# Generate a unique 32-byte Base64 key for local tests.
GUARDIAN_TOKEN_ENCRYPTION_KEY=

# Leave broker credentials empty until isolated demo credentials are provisioned.
DERIV_DEMO_APP_ID=
DERIV_DEMO_API_TOKEN=
DERIV_DEMO_ACCOUNT_ID=

# Configure only after a dedicated cTrader test app and secure callback exist.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
